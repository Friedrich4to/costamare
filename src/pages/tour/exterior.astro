---
import Layout from '../../layouts/Layout.astro';
import TourNav from '../../components/TourNav.astro';
import '@photo-sphere-viewer/core/index.css';
import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
---

<Layout title="Tour Exterior" bare={true}>
  <TourNav />
  <div class="viewer-wrap">
    <div id="psv-container"></div>
  </div>
</Layout>

<style>
  .viewer-wrap {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  #psv-container {
    width: 100%;
    height: 100%;
  }
</style>

<style is:global>
  #psv-container .psv-loader { display: none; }
</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';

  const nodes = [
    {
      id: 'piscina',
      panorama: '/tour/piscina.avif',
      name: 'Piscina',
      links: [
        { nodeId: 'gazebo',              position: { yaw: '0deg',    pitch: '0deg' } },
        { nodeId: 'piscina_costado_der', position: { yaw: '15deg',   pitch: '-10deg' } },
        { nodeId: 'piscina_costado_iz',  position: { yaw: '-50deg',  pitch: '-5deg' } },
      ],
    },
    {
      id: 'gazebo',
      panorama: '/tour/gazebo.avif',
      name: 'Gazebo',
      links: [
        { nodeId: 'piscina',             position: { yaw: '180deg', pitch: '-6deg'  } },
        { nodeId: 'piscina_costado_der', position: { yaw: '160deg',  pitch: '-5deg' } },
        { nodeId: 'piscina_costado_iz',  position: { yaw: '-140deg', pitch: '-5deg' } },
      ],
    },
    {
      id: 'piscina_costado_der',
      panorama: '/tour/piscina_costado_der.avif',
      name: 'Piscina costado der.',
      links: [
        { nodeId: 'piscina',            position: { yaw: '210deg',  pitch: '-8deg' } },
        { nodeId: 'gazebo',             position: { yaw: '-20deg',   pitch: '0deg' } },
        { nodeId: 'piscina_costado_iz', position: { yaw: '-90deg',    pitch: '-4deg' } },
      ],
    },
    {
      id: 'piscina_costado_iz',
      panorama: '/tour/piscina_costado_iz.avif',
      name: 'Piscina costado iz.',
      links: [
        { nodeId: 'piscina',             position: { yaw: '140deg',    pitch: '-5deg' } },
        { nodeId: 'gazebo',              position: { yaw: '30deg',   pitch: '0deg' } },
        { nodeId: 'piscina_costado_der', position: { yaw: '90deg',  pitch: '-5deg' } },
      ],
    },
  ];

  new Viewer({
    container: document.getElementById('psv-container') as HTMLElement,
    navbar: false,
    loadingTxt: '',
    defaultZoomLvl: 0,
    plugins: [
      [VirtualTourPlugin, {
        positionMode: 'manual',
        renderMode: '2d',
        arrowStyle: { size: { width: 40, height: 40 } },
        nodes,
      }],
    ],
  });
</script>
