---
import Layout from '../../layouts/Layout.astro';
import TourNav from '../../components/TourNav.astro';
import '@photo-sphere-viewer/core/index.css';
import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
import '@photo-sphere-viewer/map-plugin/index.css';
---

<Layout title="Tour Exterior" bare={true}>
  <TourNav />
  <div class="viewer-wrap">
    <div id="psv-container"></div>
  </div>
</Layout>

<style>
  .viewer-wrap {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  #psv-container {
    width: 100%;
    height: 100%;
  }

</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';
  import { MapPlugin } from '@photo-sphere-viewer/map-plugin';
  

  const nodes = [
    {
      id: 'piscina',
      panorama: '/tour/ext/piscina.avif',
      name: 'Piscina',
      map: { x: 650, y: 580 },
      links: [
        { nodeId: 'gazebo', position: { yaw: '90deg', pitch: '0deg' } },
        { nodeId: 'parqueo',     position: { yaw: '70deg',   pitch: '0deg' } },
        { nodeId: 'bbq',     position: { yaw: '270deg',   pitch: '0deg' } },
        { nodeId: 'gym',     position: { yaw: '275deg',   pitch: '6deg' } },
      ],
    },
    {
      id: 'parqueo',
      panorama: '/tour/ext/parqueo.avif',
      name: 'Parqueo',
      map: { x: 1125, y: 470 },
      links: [{ nodeId: 'gazebo', position: { yaw: '270deg', pitch: '-15deg' } }],
    },
    {
      id: 'bbq',
      panorama: '/tour/ext/bbq.avif',
      name: 'BBQ',
      map: { x: 390, y: 580 },
      links: [
        { nodeId: 'piscina', position: { yaw: '90deg', pitch: '-8deg' } },
        { nodeId: 'gym',  position: { yaw: '270deg',   pitch: '0deg' } },
      ],
    },
    {
      id: 'gazebo',
      panorama: '/tour/ext/gazebo.avif',
      name: 'Gazebo',
      map: { x: 990, y: 580 },
      links: [
        { nodeId: 'piscina', position: { yaw: '270deg', pitch: '-7deg' } },
        { nodeId: 'bbq', position: { yaw: '270deg', pitch: '-2deg' } },
        { nodeId: 'parqueo', position: { yaw: '20deg',   pitch: '-15deg' } },
      ],
    },
    {
      id: 'gym',
      panorama: '/tour/ext/gym.avif',
      name: 'Gimnasio',
      map: { x: 150, y: 570 },
      links: [{ nodeId: 'bbq', position: { yaw: '90deg', pitch: '-15deg' } }],
    },
  ];

  new Viewer({
    container: document.getElementById('psv-container') as HTMLElement,
    navbar: false,
    defaultZoomLvl: 0,
    plugins: [
      [MapPlugin, {
        size: '300px',
        defaultZoom: 20,
        minZoom: 10,
        maxZoom: 100,
        shape: 'square'
      }],
      [VirtualTourPlugin, {
        positionMode: 'manual',
        renderMode: '2d',
        arrowStyle: { size: { width: 40, height: 40 } },
        nodes,
        map: {
          imageUrl: '/assets/units/exterior_plan.png',
          center: { x: 240, y: 420 },
        }
      }],
    ],
  });
</script>
