---
import Layout from '../../layouts/Layout.astro';
import TourNav from '../../components/TourNav.astro';
import '@photo-sphere-viewer/core/index.css';
import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
---

<Layout title="Tour Exterior" bare={true}>
  <TourNav />
  <div class="viewer-wrap">
    <div id="psv-container"></div>
  </div>
</Layout>

<style>
  .viewer-wrap {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  #psv-container {
    width: 100%;
    height: 100%;
  }
</style>

<style is:global>
  #psv-container .psv-loader { display: none; }
</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';

  const nodes = [
    {
      id: 'piscina',
      panorama: '/tour/piscina.png',
      name: 'Piscina',
      links: [
        { nodeId: 'gazebo', position: { yaw: '0deg', pitch: '0deg' } },
      ],
    },
    {
      id: 'gazebo',
      panorama: '/tour/gazebo.png',
      name: 'Gazebo',
      links: [
        { nodeId: 'piscina', position: { yaw: '-126deg', pitch: '-6deg' } },
      ],
    },
  ];

  new Viewer({
    container: document.getElementById('psv-container') as HTMLElement,
    navbar: false,
    loadingTxt: '',
    defaultZoomLvl: 0,
    plugins: [
      [VirtualTourPlugin, {
        positionMode: 'manual',
        renderMode: '2d',
        arrowStyle: { size: { width: 40, height: 40 } },
        nodes,
      }],
    ],
  });
</script>
