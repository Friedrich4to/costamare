---
import Layout from '../../layouts/Layout.astro';
import TourNav from '../../components/TourNav.astro';
import '@photo-sphere-viewer/core/index.css';
import '@photo-sphere-viewer/virtual-tour-plugin/index.css';
import '@photo-sphere-viewer/map-plugin/index.css';
---

<Layout title="Tour Penthouse" bare={true}>
  <TourNav />
  <div class="viewer-wrap">
    <div id="psv-container"></div>
  </div>
</Layout>

<style>
  .viewer-wrap {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
  }

  #psv-container {
    width: 100%;
    height: 100%;
  }

</style>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';
  import { VirtualTourPlugin } from '@photo-sphere-viewer/virtual-tour-plugin';
  import { MapPlugin } from '@photo-sphere-viewer/map-plugin';
  

  const nodes = [
    {
      id: 'sala',
      panorama: '/tour/apt/sala_ph.avif',
      name: 'Sala',
      map: { x: 380, y: 580 },
      links: [
        { nodeId: 'cocina', position: { yaw: '356deg', pitch: '-15deg' } },
        { nodeId: 'balcon', position: { yaw: '160deg', pitch: '-25deg' } },
      ],
    },
    {
      id: 'balcon',
      panorama: '/tour/apt/balcon_ph.avif',
      name: 'Balcón',
      map: { x: 410, y: 730 },
      links: [
        { nodeId: 'sala', position: { yaw: '-15deg', pitch: '-25deg' } },
        { nodeId: 'cocina', position: { yaw: '-5deg', pitch: '-10deg' } },
      ],
    },
    {
      id: 'cocina',
      panorama: '/tour/apt/cocina_ph.avif',
      name: 'Cocina',
      map: { x: 350, y: 300 },
      links: [
        { nodeId: 'sala',        position: { yaw: '176deg', pitch: '-15deg' } },
        { nodeId: 'entrada_hab', position: { yaw: '270deg', pitch: '-15deg' } },
        { nodeId: 'terraza_1', position: { yaw: '320deg', pitch: '-15deg' } }
      ],
    },
    {
      id: 'entrada_hab',
      panorama: '/tour/apt/entrada_hab.avif',
      name: 'Entrada Hab.',
      map: { x: 200, y: 320 },
      links: [
        { nodeId: 'cocina', position: { yaw: '35deg',  pitch: '-25deg' } },
        { nodeId: 'hab',    position: { yaw: '221deg', pitch: '-25deg' } },
        { nodeId: 'terraza_1', position: { yaw: '0deg',  pitch: '-15deg' } },
      ],
    },
    {
      id: 'hab',
      panorama: '/tour/apt/hab.avif',
      name: 'Habitación',
      map: { x: 100, y: 470 },
      links: [
        { nodeId: 'entrada_hab',    position: { yaw: '30deg', pitch: '-25deg' } },
        { nodeId: 'walking_closet', position: { yaw: '4deg',  pitch: '-25deg' } },
      ],
    },
    {
      id: 'walking_closet',
      panorama: '/tour/apt/walking%20closet.avif',
      name: 'Walking Closet',
      map: { x: 120, y: 220 },
      links: [
        { nodeId: 'hab',  position: { yaw: '184deg', pitch: '-15deg' } },
        { nodeId: 'bath', position: { yaw: '0deg',   pitch: '-15deg' } },
      ],
    },
    {
      id: 'bath',
      panorama: '/tour/apt/bath.avif',
      name: 'Baño',
      map: { x: 120, y: 80 },
      links: [{ nodeId: 'walking_closet', position: { yaw: '180deg', pitch: '-45deg' } }],
    },
    {
      id: 'terraza_1',
      panorama: '/tour/apt/terraza_1.avif',
      name: 'Terraza_1',
      links: [
        { nodeId: 'entrada_hab', position: { yaw: '20deg', pitch: '-5deg' } },
        { nodeId: 'terraza_2', position: { yaw: '35deg', pitch: '-5deg' } },
      ],
    },
    {
      id: 'terraza_2',
      panorama: '/tour/apt/terraza_2.avif',
      name: 'Terraza_2',
      links: [
        { nodeId: 'entrada_hab', position: { yaw: '-55deg', pitch: '-15deg' } },
        { nodeId: 'terraza_1', position: { yaw: '230deg', pitch: '-5deg' } },
      ],
    },
  ];

  new Viewer({
    container: document.getElementById('psv-container') as HTMLElement,
    navbar: false,
    defaultZoomLvl: 0,
    plugins: [
      [MapPlugin, {
        size: '300px',
        defaultZoom: 30,
        minZoom: 10,
        maxZoom: 100,
        shape: 'square'
      }],
      [VirtualTourPlugin, {
        positionMode: 'manual',
        renderMode: '2d',
        arrowStyle: { size: { width: 40, height: 40 } },
        nodes,
        map: {
          imageUrl: '/assets/units/ph-1_map.png',
          center: { x: 240, y: 420 },
        }
      }],
    ],
  });
</script>
