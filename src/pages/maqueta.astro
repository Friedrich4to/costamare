---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Maqueta" bare>
  <div class="loading-container">
    <div class="spinner"></div>
  </div>

  <a href="/" id="back-btn">← Volver a la página</a>

  <canvas id="bg"></canvas>

  <div id="cam-pos">
    <span>pos</span>
    <span id="cam-x"></span>
    <span id="cam-y"></span>
    <span id="cam-z"></span>
    <span style="margin-left:8px">target</span>
    <span id="tgt-x"></span>
    <span id="tgt-y"></span>
    <span id="tgt-z"></span>
  </div>
</Layout>

<script src="../scripts/maqueta.js"></script>

<style>
  #bg {
    display: block;
    width: 100vw;
    height: 100vh;
  }

  .loading-container {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #181818;
    z-index: 10;
    transition: opacity 0.6s ease;
  }

  .loading-container.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  #back-btn {
    position: fixed;
    top: 16px;
    left: 16px;
    z-index: 20;
    font-size: 18px;
    color: var(--color-base);
    background: #f3f4f6;
    border: 1px solid rgba(var(--color-base), 0.2);
    padding: 12px 24px;
    border-radius: 9999px;
    text-decoration: none;
    transition: background-color 500ms, color 500ms;
  }

  #back-btn:hover {
    background: var(--color-base);
    color: #fff;
  }

  #cam-pos {
    position: fixed;
    bottom: 16px;
    left: 16px;
    display: flex;
    gap: 12px;
    font-family: monospace;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.4);
    padding: 6px 10px;
    border-radius: 6px;
    pointer-events: none;
    z-index: 5;
  }
</style>
