---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Galeria from '../components/Galeria.astro';
import Lightbox from '../components/Lightbox.astro';
import Amenidades from '../components/Amenidades.astro';
import Disponibilidad_Update from '../components/Disponibilidad_Update.astro';
import Unidades from '../components/Unidades.astro';
import MapaBavaro from '../components/MapaBavaro.astro';
import Pagos from '../components/Pagos.astro';
import '@photo-sphere-viewer/core/index.css';
import { env } from 'cloudflare:workers';

interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

let units: URow[] = [];

try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare('SELECT * FROM units ORDER BY numero').all<URow>();
    units = res.results ?? [];
  }
} catch (e) {
  console.error('index DB error:', e);
}

const unitTypes = [
  {
    id: 1,
    type_key: 'c101',
    name: 'C101',
    price_usd: 129800,
    interior_m2: 83.6,
    total_m2: 83.6,
    extra_area: { label: 'Patio', m2: 47.70 },
    features: [
      '2 Habitaciones',
      'Habitación principal con baño',
      'Sala-Comedor-Cocina',
      'Área de lavado',
      'Baño Visitas',
      'Patio',
    ],
    tour_url: '/tour/interior',
    gallery: [
      '/assets/units/101.avif',
    ],
  },
  {
    id: 2,
    type_key: '1er-piso',
    name: '1er Piso',
    price_usd: 129800,
    interior_m2: 83.6,
    total_m2: 83.6,
    extra_area: { label: 'Patio', m2: 18.4 },
    features: [
      '2 Habitaciones',
      'Habitación principal con baño',
      'Sala-Comedor-Cocina',
      'Área de lavado',
      'Baño Visitas',
      'Patio',
    ],
    tour_url: '/tour/interior',
    gallery: [
      '/assets/units/piso1.avif',
    ],
  },
  {
    id: 3,
    type_key: '2do-piso',
    name: '2do Piso',
    price_usd: 129800,
    interior_m2: 83.6,
    total_m2: 83.6,
    extra_area: null,
    features: [
      '2 Habitaciones',
      'Habitación principal con baño',
      'Sala-Comedor-Cocina',
      'Área de lavado',
      'Baño Visitas',
      'Balcón',
    ],
    tour_url: '/tour/piso-2-3',
    gallery: [
      '/assets/units/piso2-3.avif',
    ],
  },
  {
    id: 4,
    type_key: 'penthouse',
    name: 'Penthouse',
    price_usd: 129800,
    interior_m2: 83.6,
    total_m2: 83.6,
    extra_area: { label: 'Terraza', m2: 79.75 },
    features: [
      '2 Habitaciones',
      'Habitación principal con baño',
      'Sala-Comedor-Cocina',
      'Área de lavado',
      'Baño Visitas',
      'Terraza',
    ],
    tour_url: '/tour/piso-2-3',
    gallery: [
      '/assets/units/piso2-3.avif',
      '/assets/units/terraza.avif',
    ],
  },
];
---

<Layout title="Inicio">
  <main>
    <Hero />

    <section id="descripcion" class="px-[4vw] py-24 text-center">
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center gap-8">
        <div class="flex flex-col items-center gap-3">
          <p id="desc-label" class="font-display font-black text-sm uppercase tracking-[0.25em] text-second">Acerca de</p>
          <img id="desc-title" src="/logo.svg" alt="Costamare" class="w-[clamp(12rem,40vw,28rem)] h-auto" />
        </div>

        <p id="desc-paragraph" class="text-lg md:text-2xl leading-relaxed max-w-4xl text-second">
          Costamare es un desarrollo residencial de baja densidad en Costa Cana, Bávaro, Punta Cana, que combina arquitectura contemporánea con alta rentabilidad. Su propuesta reúne una ubicación estratégica con la tranquilidad de un entorno privado y exclusivo.
        </p>

        <a
          id="desc-cta"
          href="/dossier.pdf"
          download="dossier-costamare.pdf"
          class="text-xl px-10 py-4 rounded-md border-2 border-base text-base font-medium hover:bg-base hover:text-white transition-colors duration-300 no-underline"
        >
          Descarga nuestro <strong>Dossier</strong>
        </a>
      </div>
    </section>

    <Galeria />
    <Lightbox />
    <Unidades unitTypes={unitTypes} />
    <Disponibilidad_Update units={units} />
    <section id="maqueta" class="relative flex w-full h-[70svh] items-center justify-center overflow-hidden">
      <div id="maqueta-psv" class="absolute inset-0 w-full h-full" style="pointer-events:none;"></div>
      <div class="absolute inset-0 bg-base/50"></div>
      <a
        href="/tour/exterior"
        class="relative z-10 px-8 py-4 text-[18px] rounded-full bg-white text-base hover:bg-base hover:text-white transition-colors duration-300"
      >
        Explorar Tour 360°
      </a>
    </section>
        <div class="hidden"><Amenidades /></div>
    <MapaBavaro />
    <Pagos />
  </main>
</Layout>

<script>
  import '../scripts/descripcion.js';
</script>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';

  const container = document.getElementById('maqueta-psv') as HTMLElement;

  const viewer = new Viewer({
    container,
    panorama: '/tour/piscina.avif',
    navbar: false,
    defaultZoomLvl: 0,
    moveSpeed: 0,
    zoomSpeed: 0,
    mousewheel: false,
    mousemove: false,
    touchmoveTwoFingers: false,
    keyboard: false,
  });

  viewer.addEventListener('ready', () => {
    let yaw = 0;
    const SPEED = 0.0004;

    function autoRotate() {
      yaw += SPEED;
      viewer.rotate({ yaw, pitch: 0 });
      requestAnimationFrame(autoRotate);
    }

    requestAnimationFrame(autoRotate);
  }, { once: true });
</script>
