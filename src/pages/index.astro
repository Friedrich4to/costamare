---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Amenidades from '../components/Amenidades.astro';
import Galeria from '../components/Galeria.astro';
import Lightbox from '../components/Lightbox.astro';
import Disponibilidad_Section from '../components/Disponibilidad_Section.astro';
import MapaBavaro from '../components/MapaBavaro.astro';
import Pagos from '../components/Pagos.astro';
import '@photo-sphere-viewer/core/index.css';
import { env } from 'cloudflare:workers';

interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

let units: URow[] = [];

try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare('SELECT * FROM units ORDER BY numero').all<URow>();
    units = res.results ?? [];
  }
} catch (e) {
  console.error('index DB error:', e);
}
---

<Layout title="Inicio">
  <main>
    <section class="h-svh flex flex-col items-center pt-16">
      <img src="/logo.svg" alt="Costamare" class="h-24 w-auto mb-8" />

      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <a
          href="/tour/exterior"
          class="px-7 py-3 rounded-full bg-base text-white font-medium hover:bg-base/80 transition-colors duration-300 no-underline text-center pointer-events-none opacity-40"
        >
          Tour 360°
        </a>
        <a
          href="/dossier.pdf"
          download="dossier-costamare.pdf"
          class="px-7 py-3 text-base rounded-full border border-base font-medium hover:bg-base hover:text-white transition-colors duration-300 no-underline text-center pointer-events-none opacity-40"
        >
          Descargar Dossier
        </a>
      </div>

      <div class="w-full flex-1 min-h-0">
        <img
          src="assets/hero.png"
          alt="Costamare"
          class="w-full h-full object-cover object-center block"
        />
      </div>
    </section>

    <section id="descripcion" class="px-[4vw] py-20">
      <div class="w-full max-w-7xl mx-auto flex flex-col gap-10">

        <p class="leading-tight text-[2rem] lg:text-[2.75rem]">
          <strong>Costamare</strong> es un desarrollo de baja densidad diseñado para
          combinar arquitectura contemporánea con alta rentabilidad.
        </p>

        <div class="flex flex-col lg:flex-row gap-16">
          <div id="info-watermark-container" class="w-full lg:w-1/2 flex items-center justify-center self-center">
            <span
              id="info-watermark"
              class="font-black-mango font-bold uppercase leading-none select-none pointer-events-none whitespace-nowrap"
              style="color: rgba(29,29,29,0.06);"
              aria-hidden="true"
            >
              INFORMACIONES
            </span>
          </div>

          <ul class="w-full lg:w-1/2 flex flex-col gap-4">
            <li class="text-[2rem] lg:text-[2.5rem]"><strong class="font-bold">12</strong> Apartamentos</li>
            <li class="text-[2rem] lg:text-[2.5rem]">Entrega en <strong class="font-bold">Diciembre 2027</strong></li>
            <li class="text-[2rem] lg:text-[2.5rem]">Residencial <strong class="font-bold">Costa Cana</strong></li>
          </ul>
        </div>

      </div>
    </section>

    <Amenidades />
    <Galeria />
    <Lightbox />
    <!-- <Unidades unitTypes={unitTypes} /> -->
    <Disponibilidad_Section units={units} />
    <section id="maqueta" class="relative w-full h-[70svh] flex items-center justify-center overflow-hidden">
      <div id="maqueta-psv" class="absolute inset-0 w-full h-full" style="pointer-events:none;"></div>
      <div class="absolute inset-0 bg-base/50"></div>
      <a
        href="/tour/exterior"
        class="relative z-10 px-8 py-4 text-[18px] rounded-full bg-white text-base hover:bg-base hover:text-white transition-colors duration-300"
      >
        Explorar Tour 360°
      </a>
    </section>
    <MapaBavaro />
    <Pagos />
  </main>
</Layout>

<script>
  function fitWatermark() {
    const el = document.getElementById('info-watermark') as HTMLElement | null;
    const container = document.getElementById('info-watermark-container') as HTMLElement | null;
    if (!el || !container) return;
    el.style.fontSize = '100px';
    const scale = container.clientWidth / el.scrollWidth;
    el.style.fontSize = Math.floor(100 * scale) + 'px';
  }
  fitWatermark();
  window.addEventListener('resize', fitWatermark);
</script>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';

  const container = document.getElementById('maqueta-psv') as HTMLElement;

  const viewer = new Viewer({
    container,
    panorama: '/tour/ext/piscina.avif',
    navbar: false,
    defaultZoomLvl: 0,
    moveSpeed: 0,
    zoomSpeed: 0,
    mousewheel: false,
    mousemove: false,
    touchmoveTwoFingers: false,
    keyboard: false,
  });

  viewer.addEventListener('ready', () => {
    let yaw = 0;
    const SPEED = 0.0004;

    function autoRotate() {
      yaw += SPEED;
      viewer.rotate({ yaw, pitch: 0 });
      requestAnimationFrame(autoRotate);
    }

    requestAnimationFrame(autoRotate);
  }, { once: true });
</script>
