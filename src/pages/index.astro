---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import Galeria from '../components/Galeria.astro';
import Lightbox from '../components/Lightbox.astro';
import Disponibilidad_Section from '../components/Disponibilidad_Section.astro';
import MapaBavaro from '../components/MapaBavaro.astro';
import Pagos from '../components/Pagos.astro';
import '@photo-sphere-viewer/core/index.css';
import { env } from 'cloudflare:workers';

interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

let units: URow[] = [];

try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare('SELECT * FROM units ORDER BY numero').all<URow>();
    units = res.results ?? [];
  }
} catch (e) {
  console.error('index DB error:', e);
}
---

<Layout title="Inicio">
  <main>
    <section class="h-svh flex flex-col items-center pt-16">
      <img src="/logo.svg" alt="Costamare" class="h-36 w-auto mb-8" />

      <div class="w-full flex-1 min-h-0">
        <img
          src="assets/front_noBG.png"
          alt="Costamare"
          class="w-full h-full object-cover object-bottom block"
        />
      </div>
    </section>

    <section id="descripcion" class="px-[4vw] py-24">
      <div class="w-full max-w-4xl mx-auto flex flex-col items-center gap-10 text-center">
        <p id="desc-paragraph" class="leading-snug text-[1.75rem] lg:text-[2rem]">
          <strong>Costamare</strong> es un desarrollo de baja densidad diseñado para
          combinar arquitectura contemporánea con alta rentabilidad, ubicado en
          <strong>Residencial Costa Cana.</strong> Está conformado por
          <strong>12 apartamentos</strong> de <strong>83m² a 163m²,</strong>
          con entrega prevista para <strong>Diciembre 2027</strong>
        </p>
        <a
          id="desc-cta"
          href="/dossier.pdf"
          download="dossier-costamare.pdf"
          class="px-8 py-4 rounded-full bg-base text-white font-medium hover:bg-base/80 transition-colors duration-300 no-underline"
        >
          Descarga nuestro <strong>Dossier</strong>
        </a>
      </div>
    </section>

    <Galeria />
    <Lightbox />
    <!-- <Unidades unitTypes={unitTypes} /> -->
    <Disponibilidad_Section units={units} />
    <section id="maqueta" class="relative w-full h-[70svh] flex items-center justify-center overflow-hidden">
      <div id="maqueta-psv" class="absolute inset-0 w-full h-full" style="pointer-events:none;"></div>
      <div class="absolute inset-0 bg-base/50"></div>
      <a
        href="/tour/exterior"
        class="relative z-10 px-8 py-4 text-[18px] rounded-full bg-white text-base hover:bg-base hover:text-white transition-colors duration-300"
      >
        Explorar Tour 360°
      </a>
    </section>
    <MapaBavaro />
    <Pagos />
  </main>
</Layout>

<script>
  import '../scripts/descripcion.js';
</script>

<script>
  import { Viewer } from '@photo-sphere-viewer/core';

  const container = document.getElementById('maqueta-psv') as HTMLElement;

  const viewer = new Viewer({
    container,
    panorama: '/tour/ext/piscina.avif',
    navbar: false,
    defaultZoomLvl: 0,
    moveSpeed: 0,
    zoomSpeed: 0,
    mousewheel: false,
    mousemove: false,
    touchmoveTwoFingers: false,
    keyboard: false,
  });

  viewer.addEventListener('ready', () => {
    let yaw = 0;
    const SPEED = 0.0004;

    function autoRotate() {
      yaw += SPEED;
      viewer.rotate({ yaw, pitch: 0 });
      requestAnimationFrame(autoRotate);
    }

    requestAnimationFrame(autoRotate);
  }, { once: true });
</script>
