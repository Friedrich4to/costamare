---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

type ParsedUnit = Omit<URow, 'gallery'> & { gallery: string[] };

let units: ParsedUnit[] = [];
let dbError = false;

try {
  const db = env.DB;
  if (db) {
    const res = await db.prepare('SELECT * FROM units ORDER BY numero').all<URow>();
    units = (res.results ?? []).map(u => ({
      ...u,
      gallery: JSON.parse(u.gallery || '[]'),
    }));
  } else {
    dbError = true;
  }
} catch (e) {
  dbError = true;
  console.error('admin DB error:', e);
}
---

<Layout title="Administración" bare={true}>
  <!-- ── Auth overlay ─────────────────────────────────────── -->
  <div id="auth-overlay" class="fixed inset-0 z-50 flex items-center justify-center" style="background:rgba(29,29,29,0.97);backdrop-filter:blur(4px)">
    <div style="background:#fff;border-radius:1.25rem;padding:2.5rem;width:100%;max-width:22rem;margin:1rem;box-shadow:0 25px 60px rgba(0,0,0,0.4)">
      <p class="admin-logo">Costamare</p>
      <h1 style="font-size:1.25rem;font-weight:600;color:#1D1D1D;margin:0 0 0.25rem">Panel de Administración</h1>
      <p style="font-size:0.8rem;color:#9ca3af;margin:0 0 1.75rem">Introduce tu API Key para continuar</p>
      <input id="api-key-input" type="password" placeholder="API Key" autocomplete="current-password"
        style="width:100%;border:1.5px solid #E3E3E3;border-radius:0.6rem;padding:0.7rem 0.9rem;font-size:0.875rem;color:#1D1D1D;box-sizing:border-box;font-family:inherit;outline:none;transition:border-color .15s"
        onfocus="this.style.borderColor='#1D1D1D'" onblur="this.style.borderColor='#E3E3E3'"
      />
      <p id="auth-error" style="display:none;color:#C23E3E;font-size:0.8rem;margin:0.5rem 0 0">Clave incorrecta. Inténtalo de nuevo.</p>
      <button id="auth-submit" style="width:100%;margin-top:1rem;background:#1D1D1D;color:#fff;border:none;border-radius:0.6rem;padding:0.8rem;font-size:0.875rem;font-weight:600;cursor:pointer;font-family:inherit;transition:opacity .15s" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
        Ingresar
      </button>
    </div>
  </div>

  <!-- ── Admin panel ─────────────────────────────────────── -->
  <div id="admin-panel" style="display:none;min-height:100vh;background:#F0F0F0">

    <!-- Sticky header -->
    <header style="position:sticky;top:0;z-index:40;background:#1D1D1D;padding:0 1.5rem;height:3.75rem;display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:0.75rem">
        <span style="font-family:var(--font-display);font-weight:700;color:#fff;font-size:1.1rem;letter-spacing:.04em">Costamare</span>
        <span style="color:rgba(255,255,255,.45);font-size:0.8rem">Panel de Administración</span>
      </div>
      <div style="display:flex;align-items:center;gap:1rem">
        <a href="/admin_disp" style="color:rgba(255,255,255,.65);font-size:0.8rem;text-decoration:none;transition:color .15s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,.65)'">Vista rápida</a>
        <button id="logout-btn" style="background:rgba(255,255,255,.12);color:rgba(255,255,255,.8);border:none;border-radius:0.5rem;padding:0.4rem 0.9rem;font-size:0.8rem;cursor:pointer;font-family:inherit;transition:background .15s" onmouseover="this.style.background='rgba(255,255,255,.2)'" onmouseout="this.style.background='rgba(255,255,255,.12)'">
          Cerrar sesión
        </button>
      </div>
    </header>

    {dbError && (
      <div style="margin:2rem auto;max-width:40rem;background:#fef2f2;border:1px solid #fca5a5;border-radius:.75rem;padding:1rem 1.25rem;color:#991b1b;font-size:.875rem">
        Error de conexión con la base de datos. Verifica que la D1 esté configurada correctamente.
      </div>
    )}

    <div style="max-width:72rem;margin:0 auto;padding:2rem 1.25rem 8rem">

      <!-- ── Sección: Unidades ───────────────────────── -->
      <section>
        <h2 class="section-title">Unidades</h2>
        <div class="ut-grid">
          {units.map(unit => (
            <div class="ut-card" data-numero={unit.numero}>
              <!-- Card header -->
              <div style="background:#1D1D1D;padding:1rem 1.25rem">
                <p style="font-weight:700;color:#fff;font-size:1.1rem;margin:0">Unidad {unit.numero}</p>
              </div>

              <!-- Card body -->
              <div style="padding:1.25rem;display:flex;flex-direction:column;gap:1rem">

                <!-- Precio -->
                <div class="field-group">
                  <label class="field-label">Precio (USD)</label>
                  <input type="number" data-field="precio" value={unit.precio} min="0" step="1" class="field-input" />
                </div>

                <!-- Areas -->
                <div class="field-row-2">
                  <div class="field-group">
                    <label class="field-label">m²</label>
                    <input type="number" data-field="m2" value={unit.m2} step="0.01" class="field-input" />
                  </div>
                  <div class="field-group">
                    <label class="field-label">m² Total</label>
                    <input type="number" data-field="m2_total" value={unit.m2_total} step="0.01" class="field-input" />
                  </div>
                </div>
                <div class="field-row-2">
                  <div class="field-group">
                    <label class="field-label">Terraza m²</label>
                    <input type="number" data-field="terraza_m2" value={unit.terraza_m2 ?? ''} step="0.01" placeholder="—" class="field-input" />
                  </div>
                  <div class="field-group">
                    <label class="field-label">Patio m²</label>
                    <input type="number" data-field="patio_m2" value={unit.patio_m2 ?? ''} step="0.01" placeholder="—" class="field-input" />
                  </div>
                </div>

                <!-- Disponibilidad -->
                <div class="field-group">
                  <label class="field-label">Disponibilidad</label>
                  <select data-field="disponibilidad" class="status-select field-select">
                    <option value="available" selected={unit.disponibilidad === 'available'}>Disponible</option>
                    <option value="reserved" selected={unit.disponibilidad === 'reserved'}>Reservado</option>
                    <option value="sold" selected={unit.disponibilidad === 'sold'}>Vendido</option>
                  </select>
                </div>

                <!-- Tour URL -->
                <div class="field-group">
                  <label class="field-label">URL del Tour</label>
                  <input type="text" data-field="tour_url" value={unit.tour_url ?? ''} class="field-input" />
                </div>

                <!-- Gallery -->
                <div class="field-group">
                  <label class="field-label">Galería <span style="font-weight:400;text-transform:none;letter-spacing:0;color:#9ca3af">(una URL por línea)</span></label>
                  <textarea data-field="gallery" rows={Math.max(2, unit.gallery.length + 1)} class="field-input" style="resize:vertical;font-family:monospace;font-size:.8rem">{unit.gallery.join('\n')}</textarea>
                </div>

              </div>
            </div>
          ))}
        </div>
      </section>

    </div><!-- /content -->

    <!-- Sticky save bar -->
    <div style="position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #E3E3E3;padding:.875rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;z-index:30">
      <span id="save-status" style="font-size:.875rem;color:#6b7280"></span>
      <div style="display:flex;align-items:center;gap:.75rem">
        <button id="download-btn" style="display:inline-flex;align-items:center;gap:.45rem;background:#F0F0F0;color:#1D1D1D;border:1.5px solid rgba(29,29,29,.2);border-radius:.625rem;padding:.7rem 1.25rem;font-size:.875rem;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;transition:background .15s,color .15s" onmouseover="this.style.background='#1D1D1D';this.style.color='#fff'" onmouseout="this.style.background='#F0F0F0';this.style.color='#1D1D1D'">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar listado
        </button>
        <button id="save-btn" style="background:#1D1D1D;color:#fff;border:none;border-radius:.625rem;padding:.7rem 2rem;font-size:.875rem;font-weight:600;cursor:pointer;font-family:inherit;transition:opacity .15s;white-space:nowrap" onmouseover="this.style.opacity='.85'" onmouseout="this.style.opacity='1'">
          Guardar cambios
        </button>
      </div>
    </div>

  </div><!-- /admin-panel -->
</Layout>

<style>
  .admin-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: #1D1D1D;
    letter-spacing: .06em;
    margin: 0 0 .75rem;
  }
  .section-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1D1D1D;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin: 0 0 1.25rem;
  }
  .field-label {
    display: block;
    font-size: .7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #9ca3af;
    margin-bottom: .3rem;
  }
  .field-input {
    width: 100%;
    border: 1.5px solid #E3E3E3;
    border-radius: .5rem;
    padding: .5rem .75rem;
    font-size: .875rem;
    color: #1D1D1D;
    background: #fff;
    box-sizing: border-box;
    font-family: inherit;
    outline: none;
    transition: border-color .15s;
  }
  .field-input:focus { border-color: #1D1D1D; }
  .field-select {
    width: 100%;
    border: 1.5px solid #E3E3E3;
    border-radius: .5rem;
    padding: .5rem .75rem;
    font-size: .85rem;
    color: #1D1D1D;
    background: #fff;
    box-sizing: border-box;
    font-family: inherit;
    outline: none;
    cursor: pointer;
    transition: border-color .15s, background-color .15s, color .15s;
  }
  .field-select:focus { border-color: #1D1D1D; }
  .field-group { display: flex; flex-direction: column; }
  .field-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }

  .ut-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .ut-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .ut-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .ut-card {
    background: #fff;
    border-radius: .875rem;
    border: 1px solid #E3E3E3;
    overflow: hidden;
  }
</style>

<script>
  const STORAGE_KEY = 'costamare_admin_key';

  const STATUS_COLORS: Record<string, { bg: string; color: string; border: string }> = {
    available: { bg: '#f0fdf4', color: '#166534', border: '#86efac' },
    reserved:  { bg: '#fffbeb', color: '#92400e', border: '#fde68a' },
    sold:      { bg: '#fef2f2', color: '#991b1b', border: '#fca5a5' },
  };

  function colorizeStatus(sel: HTMLSelectElement) {
    const c = STATUS_COLORS[sel.value];
    if (c) {
      sel.style.backgroundColor = c.bg;
      sel.style.color = c.color;
      sel.style.borderColor = c.border;
    }
  }

  function initStatusColors() {
    document.querySelectorAll<HTMLSelectElement>('.status-select').forEach(sel => {
      colorizeStatus(sel);
      sel.addEventListener('change', () => colorizeStatus(sel));
    });
  }

  function collectUnits() {
    return Array.from(document.querySelectorAll<HTMLElement>('.ut-card[data-numero]')).map(card => {
      const get = (field: string) =>
        (card.querySelector(`[data-field="${field}"]`) as HTMLInputElement | HTMLTextAreaElement)?.value ?? '';

      const gallery = get('gallery').split('\n').map(g => g.trim()).filter(Boolean);

      return {
        numero:        card.dataset.numero!,
        m2:            parseFloat(get('m2')) || 0,
        patio_m2:      get('patio_m2') ? parseFloat(get('patio_m2')) : null,
        terraza_m2:    get('terraza_m2') ? parseFloat(get('terraza_m2')) : null,
        m2_total:      parseFloat(get('m2_total')) || 0,
        disponibilidad: (card.querySelector('[data-field="disponibilidad"]') as HTMLSelectElement).value,
        tour_url:      get('tour_url') || null,
        gallery,
        precio:        parseFloat(get('precio')) || 0,
      };
    });
  }

  async function verifyKey(key: string): Promise<boolean> {
    try {
      const res = await fetch('/api/admin/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key }),
      });
      return res.ok && (await res.json()).ok === true;
    } catch { return false; }
  }

  function showPanel() {
    (document.getElementById('auth-overlay') as HTMLElement).style.display = 'none';
    (document.getElementById('admin-panel') as HTMLElement).style.display = 'block';
    initStatusColors();
  }

  const storedKey = sessionStorage.getItem(STORAGE_KEY);
  if (storedKey) {
    verifyKey(storedKey).then(ok => {
      if (ok) showPanel();
      else sessionStorage.removeItem(STORAGE_KEY);
    });
  }

  const authInput = document.getElementById('api-key-input') as HTMLInputElement;
  const authBtn   = document.getElementById('auth-submit')  as HTMLButtonElement;
  const authError = document.getElementById('auth-error')   as HTMLElement;

  authInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') authBtn.click(); });

  authBtn.addEventListener('click', async () => {
    const key = authInput.value.trim();
    if (!key) return;
    authBtn.disabled = true;
    authBtn.textContent = 'Verificando...';
    authError.style.display = 'none';
    const ok = await verifyKey(key);
    if (ok) {
      sessionStorage.setItem(STORAGE_KEY, key);
      showPanel();
    } else {
      authError.style.display = 'block';
      authBtn.disabled = false;
      authBtn.textContent = 'Ingresar';
    }
  });

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    sessionStorage.removeItem(STORAGE_KEY);
    location.reload();
  });

  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  downloadBtn?.addEventListener('click', async () => {
    const originalHTML = downloadBtn.innerHTML;
    downloadBtn.disabled = true;
    downloadBtn.textContent = 'Generando PDF…';
    try {
      const res = await fetch('/api/pdf', { method: 'POST' });
      if (!res.ok) throw new Error();
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'listado-precios-costamare.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch {
      alert('Error generando el PDF. Inténtalo de nuevo.');
    } finally {
      downloadBtn.disabled = false;
      downloadBtn.innerHTML = originalHTML;
    }
  });

  const saveBtn    = document.getElementById('save-btn')    as HTMLButtonElement;
  const saveStatus = document.getElementById('save-status') as HTMLElement;

  saveBtn.addEventListener('click', async () => {
    const key = sessionStorage.getItem(STORAGE_KEY);
    if (!key) return;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Guardando...';
    saveStatus.textContent = '';
    saveStatus.style.color = '#6b7280';
    try {
      const units = collectUnits();
      const res = await fetch('/api/admin/save-units', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, units }),
      });
      const data = await res.json();
      if (data.ok) {
        saveStatus.textContent = '✓ Cambios guardados correctamente';
        saveStatus.style.color = '#166534';
      } else {
        saveStatus.textContent = '✗ Error al guardar. Inténtalo de nuevo.';
        saveStatus.style.color = '#991b1b';
      }
    } catch {
      saveStatus.textContent = '✗ Error de conexión';
      saveStatus.style.color = '#991b1b';
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Guardar cambios';
      setTimeout(() => { saveStatus.textContent = ''; }, 5000);
    }
  });
</script>
