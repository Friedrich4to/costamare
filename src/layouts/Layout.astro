---
import '../styles/global.css'
import Navbar from '../components/navbar.astro'
import Footer from '../components/footer.astro'
interface Props { title?: string; bare?: boolean }
const { title = 'Costamare', bare = false } = Astro.props
const pageTitle = `Costamare - ${title}`
const description = 'Ubicado en Bávaro, Punta Cana, Costamare es un desarrollo residencial diseñado para combinar arquitectura contemporánea con alta rentabilidad.'
const ogImage = '/assets/gallery/frente.jpg'
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<!-- Open Graph -->
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_DO" />
		<meta property="og:site_name" content="Costamare" />
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		{!bare && <Navbar />}
		<slot />
		{!bare && <Footer />}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
