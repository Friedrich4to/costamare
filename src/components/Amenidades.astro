<section id="amenidades" class="flex flex-col md:flex-row min-h-[80svh]">

  <!-- LEFT DARK PANEL: second on mobile (below image), first on desktop -->
  <div class="order-2 md:order-1 w-full md:w-1/2 bg-base text-white flex flex-col justify-center">
    <div class="pl-[max(4vw,calc((100vw-80rem)/2))] pr-[4vw] py-16">

      <!-- Amenidades Accordion -->
      <div class="accordion-item" data-accordion="amenidades">
        <button class="accordion-trigger w-full text-left flex items-center justify-between gap-4 py-2 cursor-pointer">
          <h2 class="font-display text-2xl md:text-3xl amenidades-heading">Amenidades</h2>
          <svg class="chevron w-5 h-5 amenidades-chevron transition-transform duration-300 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="accordion-content overflow-hidden" style="max-height: 0;">
          <ul class="flex flex-col gap-4 pt-6 pb-2 text-xl font-light amenidades-list">
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/area_social.svg');"></span>
              <span>Área social con Piscina</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/terraza.svg');"></span>
              <span>Terraza amueblada</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/barbecue.svg');"></span>
              <span>Área de Barbecue</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/jardin.svg');"></span>
              <span>Jardines preciosos</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/parqueo.svg');"></span>
              <span>Parqueos privados</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/camara.svg');"></span>
              <span>Cámaras de seguridad</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="amenidad-icon opacity-60" style="mask-image: url('/assets/icons/acceso.svg');"></span>
              <span>Acceso controlado</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Terminaciones Accordion -->
      <div class="accordion-item mt-2" data-accordion="terminaciones">
        <button class="accordion-trigger w-full text-left flex items-center justify-between gap-4 py-2 cursor-pointer">
          <h2 class="font-display text-2xl md:text-3xl amenidades-heading">Terminaciones</h2>
          <svg class="chevron w-5 h-5 amenidades-chevron transition-transform duration-300 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="accordion-content overflow-hidden" style="max-height: 0;">
          <ul class="flex flex-col gap-4 pt-6 pb-2 text-xl font-light amenidades-list">
            <li><strong>Pisos en porcelanato</strong> de alta calidad</li>
            <li><strong>Cocinas modulares</strong> contemporáneas</li>
            <li>Tope de cocina en <strong>granito natural</strong></li>
            <li><strong>Revestimientos cerámicos</strong> en baños</li>
            <li>Puertas de <strong>ingeniería</strong></li>
            <li><strong>Ventanas corredizas</strong> en aluminio y vidrio</li>
            <li>Preinstalación de <strong>aire acondicionado</strong></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

  <!-- RIGHT IMAGE PANEL: first on mobile (appears above), second on desktop -->
  <div class="order-1 md:order-2 w-full md:w-1/2 relative h-[40svh] md:h-auto overflow-hidden">
    <img
      id="img-amenidades"
      src="/assets/gallery/social_2.jpg"
      alt="Área social"
      class="absolute inset-0 w-full h-full object-cover opacity-100 transition-opacity duration-700 ease-in-out"
    />
    <img
      id="img-terminaciones"
      src="/assets/gallery/cocina_acabados.jpg"
      alt="Terminaciones"
      class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-700 ease-in-out"
    />
  </div>

</section>

<style>
  .amenidad-icon {
    display: inline-block;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    background-color: var(--color-white);
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }

  .amenidades-heading,
  .amenidades-chevron {
    color: var(--color-white);
  }

  .amenidades-list li {
    color: var(--color-white);
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('#amenidades .accordion-item');
  const imgAmenidades    = document.getElementById('img-amenidades');
  const imgTerminaciones = document.getElementById('img-terminaciones');

  function openAccordion(key: string) {
    items.forEach(item => {
      const isTarget = item.dataset.accordion === key;
      const content  = item.querySelector<HTMLElement>('.accordion-content')!;
      const chevron  = item.querySelector<SVGElement>('.chevron')!;

      if (isTarget) {
        content.style.maxHeight = content.scrollHeight + 'px';
        chevron.classList.add('rotate-180');
      } else {
        content.style.maxHeight = '0';
        chevron.classList.remove('rotate-180');
      }
    });

    if (imgAmenidades && imgTerminaciones) {
      if (key === 'amenidades') {
        imgAmenidades.classList.replace('opacity-0', 'opacity-100');
        imgTerminaciones.classList.replace('opacity-100', 'opacity-0');
      } else {
        imgTerminaciones.classList.replace('opacity-0', 'opacity-100');
        imgAmenidades.classList.replace('opacity-100', 'opacity-0');
      }
    }
  }

  items.forEach(item => {
    item.querySelector('.accordion-trigger')!.addEventListener('click', () => {
      openAccordion(item.dataset.accordion!);
    });
  });

  openAccordion('amenidades');

  // Lock the left panel height to the expanded-amenidades state so switching
  // accordions doesn't resize the section.
  const leftPanel = document.querySelector<HTMLElement>('#amenidades .order-2');
  if (leftPanel) {
    // Measure without animation by temporarily disabling it
    const amenContent = document.querySelector<HTMLElement>('#amenidades [data-accordion="amenidades"] .accordion-content');
    if (amenContent) {
      amenContent.style.transition = 'none';
      amenContent.style.maxHeight = amenContent.scrollHeight + 'px';
    }
    // Read height after style flush
    void leftPanel.offsetHeight;
    leftPanel.style.minHeight = leftPanel.offsetHeight + 'px';
    // Restore transition
    if (amenContent) amenContent.style.transition = '';
  }
</script>
