---
const amenidades = [
  { label: 'Gimnasio equipado',       img: '/assets/placeholder.avif' },
  { label: 'Área social con Piscina', img: '/assets/placeholder.avif' },
  { label: 'Terraza amueblada',       img: '/assets/placeholder.avif' },
  { label: 'Área de Barbecue',        img: '/assets/placeholder.avif' },
  { label: 'Jardines preciosos',      img: '/assets/placeholder.avif' },
  { label: 'Parqueos privados',       img: '/assets/placeholder.avif' },
];
---

<section id="amenidades" class="px-[4vw] py-20">
  <div class="w-full max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      {amenidades.map(({ label, img }, i) => {
        const imgLeft = i % 2 === 0;
        return (
          <div class={`flex h-28 overflow-hidden bg-base ${imgLeft ? 'rounded-l-sm rounded-r-full' : 'rounded-l-full rounded-r-sm'}`}>
            {imgLeft && (
              <img
                src={img}
                alt={label}
                loading="lazy"
                class="h-full w-3/5 object-cover object-center rounded-l-sm shrink-0"
              />
            )}
            <div class="flex-1 flex items-center justify-center px-4">
              <span class="text-white text-sm font-semibold text-center leading-tight">{label}</span>
            </div>
            {!imgLeft && (
              <img
                src={img}
                alt={label}
                loading="lazy"
                class="h-full w-3/5 object-cover object-center rounded-r-sm shrink-0"
              />
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
