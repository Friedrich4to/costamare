---

<section id="pagos" class="bg-second text-white px-[4vw] py-24 lg:flex lg:items-center">
  <div class="max-w-7xl mx-auto flex flex-col gap-10">

    <h2 class="text-3xl md:text-4xl lg:text-5xl text-center">
      <span class="font-display font-bold italic">Plan flexible</span>
    </h2>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">

      <li class="flex items-start gap-4 px-6 py-6 lg:pl-0 border-b border-white/20 md:border-b md:border-r lg:border-b-0 lg:border-r">
        <span class="font-display font-bold text-6xl text-base/40 leading-none select-none">1</span>
        <div class="flex flex-col gap-1">
          <p class="font-display font-bold text-2xl md:text-3xl">US$ 1,000</p>
          <p class="text-sm text-white/70 leading-snug">Reservación</p>
        </div>
      </li>

      <li class="flex items-start gap-4 px-6 py-6 border-b border-white/20 md:border-b md:border-r-0 lg:border-b-0 lg:border-r">
        <span class="font-display font-bold text-6xl text-base/40 leading-none select-none">2</span>
        <div class="flex flex-col gap-1">
          <p class="font-display font-bold text-2xl md:text-3xl">10%</p>
          <p class="text-sm text-white/70 leading-snug">Separación a la firma del contrato.</p>
        </div>
      </li>

      <li class="flex items-start gap-4 px-6 py-6 border-b border-white/20 md:border-b-0 md:border-r lg:border-b-0 lg:border-r">
        <span class="font-display font-bold text-6xl text-base/40 leading-none select-none">3</span>
        <div class="flex flex-col gap-1">
          <p class="font-display font-bold text-2xl md:text-3xl">30%</p>
          <p class="text-sm text-white/70 leading-snug">Durante la construcción.</p>
        </div>
      </li>

      <li class="flex items-start gap-4 px-6 py-6 border-b-0 md:border-r-0 lg:border-r-0">
        <span class="font-display font-bold text-6xl text-base/40 leading-none select-none">4</span>
        <div class="flex flex-col gap-1">
          <p class="font-display font-bold text-2xl md:text-3xl">60%</p>
          <p class="text-sm text-white/70 leading-snug">Contra entrega.</p>
        </div>
      </li>

    </ul>

    <div class="flex justify-center pt-6">
      <img src="/logo.svg" alt="Costamare" class="h-25 w-auto brightness-0 invert opacity-80" />
    </div>

  </div>
</section>
