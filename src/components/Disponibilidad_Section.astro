---
interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

interface Props {
  units: URow[];
  hideHeader?: boolean;
}

const { units: rawUnits, hideHeader = false } = Astro.props;

const units = rawUnits.map(u => ({
  id:             u.numero,
  numero:         u.numero,
  disponibilidad: u.disponibilidad,
  m2:             u.m2,
  patio_m2:       u.patio_m2,
  terraza_m2:     u.terraza_m2,
  m2_total:       u.m2_total,
  tourUrl:        u.tour_url ?? '#',
  precio:         u.precio,
}));

type Unit = typeof units[0];

const statusDot: Record<string, string> = {
  available: 'bg-green-500',
  reserved:  'bg-yellow-500',
  sold:      'bg-red-500',
};
const statusText: Record<string, string> = {
  available: 'text-green-700',
  reserved:  'text-yellow-700',
  sold:      'text-red-700',
};
const statusBg: Record<string, string> = {
  available: 'bg-green-50',
  reserved:  'bg-yellow-50',
  sold:      'bg-red-50',
};
const statusLabel: Record<string, string> = {
  available: 'Disponible',
  reserved:  'Reservado',
  sold:      'Vendido',
};

---

<section id="disponibilidad" class:list={["px-[4vw]", hideHeader ? "pt-4 pb-16" : "py-16"]}>
  <div class="max-w-7xl mx-auto">

    {!hideHeader && (
      <div class="mb-8">
        <h2 class="font-display font-bold text-3xl mb-4">Disponibilidad</h2>
        <button
          id="d-pdf-btn"
          class="flex items-center gap-2 px-5 py-2.5 text-sm rounded-full bg-gray-100 border border-base/20 hover:bg-base hover:text-white transition-colors duration-500 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar lista PDF
        </button>
      </div>
    )}

    <div class="flex flex-col-reverse lg:flex-row gap-8 items-start">

      <!-- Left on desktop / bottom on tablet+mobile: unit cards list -->
      <div class="w-full lg:w-[35%] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 gap-3">
        {units.map(unit => (
          <div
            class="d-unit-card border border-base/20 rounded-xl overflow-hidden cursor-pointer select-none"
            data-unit={unit.id}
          >
            <!-- Collapsed header -->
            <div class="flex items-center justify-between px-4 py-3 gap-3">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="font-display font-bold text-lg shrink-0">{unit.numero}</span>
                <span class:list={['flex items-center gap-1.5 text-sm shrink-0 px-2 py-0.5 rounded-full', statusText[unit.disponibilidad], statusBg[unit.disponibilidad]]}>
                  <span class:list={['w-2 h-2 rounded-full shrink-0', statusDot[unit.disponibilidad]]}></span>
                  {statusLabel[unit.disponibilidad]}
                </span>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-sm text-base/50">{unit.m2_total} m²</span>
                {!['reserved', 'sold'].includes(unit.disponibilidad) && (
                  <span class="font-bold text-sm">US$ {unit.precio.toLocaleString('en-US')}</span>
                )}
                <svg
                  class="d-chevron shrink-0 transition-transform duration-200"
                  xmlns="http://www.w3.org/2000/svg"
                  width="14" height="14" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </div>
            </div>

            <!-- Expanded detail -->
            <div class="d-unit-detail hidden px-4 pb-4">
              <div class="flex flex-col gap-3 pt-3 border-t border-base/10">

                <!-- Info rows -->
                <div class="flex flex-col gap-2 text-sm text-base/75">

                  <!-- Areas -->
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
                    <span class="flex items-center gap-1.5">
                      <img src="/assets/icons/size.svg" alt="" class="h-4 w-auto" aria-hidden="true" />
                      <span class="opacity-50">{unit.m2} m² interior</span>
                    </span>
                    {unit.patio_m2 && (
                      <span class="flex items-center gap-1 opacity-50">
                        <span class="opacity-60">+</span>
                        {unit.patio_m2} m² patio
                      </span>
                    )}
                    {unit.terraza_m2 && (
                      <span class="flex items-center gap-1 opacity-50">
                        <span class="opacity-60">+</span>
                        {unit.terraza_m2} m² terraza
                      </span>
                    )}
                    {(unit.patio_m2 || unit.terraza_m2) && (
                      <span class="font-medium text-base/90">= {unit.m2_total} m² total</span>
                    )}
                  </div>

                  <!-- Fixed features -->
                  <div class="flex items-center gap-x-4 gap-y-1.5 flex-wrap">
                    <span class="flex items-center gap-1.5">
                      <img src="/assets/icons/room.svg" alt="" class="h-4 w-auto" aria-hidden="true" />
                      2 habitaciones
                    </span>
                    <span class="flex items-center gap-1.5">
                      <img src="/assets/icons/bath.svg" alt="" class="h-4 w-auto" aria-hidden="true" />
                      2 baños
                    </span>
                    <span class="flex items-center gap-1.5">
                      <img src="/assets/icons/parqueo.svg" alt="" class="h-4 w-auto" aria-hidden="true" />
                      1 parqueo
                    </span>
                  </div>

                </div>

                <!-- Buttons -->
                <a
                  href={unit.tourUrl}
                  class="block text-center px-4 py-3 rounded-lg bg-base text-white font-bold text-sm leading-none hover:bg-base/80 transition-colors duration-200 no-underline pointer-events-none opacity-40"
                >
                  Explorar Tour 360°
                </a>
                <a
                  href={`/assets/units_info/${unit.id}.pdf`}
                  download
                  class="block text-center px-4 py-3 rounded-lg border border-base/25 text-base/70 text-sm font-medium hover:bg-base/5 transition-colors duration-200 no-underline"
                >
                  Descargar ficha técnica
                </a>

              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right on desktop / top on tablet+mobile: building elevation -->
      <div class="w-full lg:flex-1 lg:min-w-0 lg:sticky lg:top-[10svh] pt-0 lg:pt-24">
        <div class="relative">

          <svg
            class="absolute inset-0 w-full h-full"
            viewBox="0 0 2107 645"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <!-- Floor 1 -->
            <rect data-unit="101" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="35"   y="488" width="426" height="157" fill="#002E6B"/>
            <rect data-unit="102" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="602"  y="488" width="451" height="157" fill="#002E6B"/>
            <rect data-unit="103" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1053" y="488" width="451" height="157" fill="#002E6B"/>
            <rect data-unit="104" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1646" y="488" width="426" height="157" fill="#002E6B"/>
            <!-- Floor 2 -->
            <rect data-unit="201" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="35"   y="331" width="426" height="157" fill="#002E6B"/>
            <rect data-unit="202" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="602"  y="331" width="451" height="157" fill="#002E6B"/>
            <rect data-unit="203" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1053" y="331" width="451" height="157" fill="#002E6B"/>
            <rect data-unit="204" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1646" y="331" width="426" height="157" fill="#002E6B"/>
            <!-- Penthouse -->
            <rect data-unit="301" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="35"   y="29"  width="426" height="302" fill="#002E6B"/>
            <rect data-unit="302" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="602"  y="29"  width="451" height="302" fill="#002E6B"/>
            <rect data-unit="303" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1053" y="29"  width="451" height="302" fill="#002E6B"/>
            <rect data-unit="304" class="d-unit-shape" style="opacity:0;cursor:pointer;transition:opacity 0.2s" x="1646" y="29"  width="426" height="302" fill="#002E6B"/>
          </svg>

          <img
            src="/assets/unidades/units-base-building.svg"
            alt="Plano del edificio"
            class="relative w-full block pointer-events-none"
          />

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function getShape(unitId: string) {
    return document.querySelector<SVGRectElement>(`.d-unit-shape[data-unit="${unitId}"]`);
  }

  function openUnit(unitId: string) {
    document.querySelectorAll<HTMLElement>('.d-unit-card').forEach(card => {
      const detail  = card.querySelector<HTMLElement>('.d-unit-detail');
      const chevron = card.querySelector<SVGElement>('.d-chevron');
      const shape   = getShape(card.dataset.unit!);
      if (card.dataset.unit === unitId) {
        const opening = detail!.classList.contains('hidden');
        detail!.classList.toggle('hidden', !opening);
        chevron!.style.transform  = opening ? 'rotate(180deg)' : '';
        if (shape) shape.style.opacity = opening ? '0.5' : '0';
        if (opening) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        detail!.classList.add('hidden');
        chevron!.style.transform = '';
        if (shape) shape.style.opacity = '0';
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.d-unit-card').forEach(card => {
    card.addEventListener('click', () => openUnit(card.dataset.unit!));
  });

  document.querySelectorAll<SVGRectElement>('.d-unit-shape').forEach(shape => {
    shape.addEventListener('click', () => openUnit(shape.dataset.unit!));
    shape.addEventListener('mouseenter', () => {
      if (shape.style.opacity === '0') shape.style.opacity = '0.25';
    });
    shape.addEventListener('mouseleave', () => {
      if (shape.style.opacity === '0.25') shape.style.opacity = '0';
    });
  });

  const pdfBtn = document.getElementById('d-pdf-btn') as HTMLButtonElement | null;
  pdfBtn?.addEventListener('click', async () => {
    const originalHTML = pdfBtn.innerHTML;
    pdfBtn.disabled = true;
    pdfBtn.textContent = 'Generando PDF…';

    try {
      const res = await fetch('/api/pdf', { method: 'POST' });
      if (!res.ok) throw new Error();

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'listado-precios-costamare.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch {
      alert('Error generando el PDF. Inténtalo de nuevo.');
    } finally {
      pdfBtn.disabled = false;
      pdfBtn.innerHTML = originalHTML;
    }
  });
</script>
