---
---

<section id="hero-alt" class="h-[90svh] flex flex-col bg-white">

  <!-- Main content: stacked on mobile/tablet, split on lg+ -->
  <div class="flex flex-col lg:flex-row flex-1 overflow-hidden">

    <!-- Left column: text content -->
    <div class="lg:w-1/2 flex flex-col justify-center px-6 sm:px-10 lg:pl-12 lg:pr-10 xl:pl-20 2xl:pl-24 py-12 lg:py-0">

      <h1 class="font-black-mango font-bold text-second leading-[1.05] mb-1
                 text-4xl sm:text-5xl lg:text-[3.8rem] xl:text-[4.2rem]">
        Vive cerca de todo.
      </h1>
      <h1 class="font-black-mango font-bold italic text-second leading-[1.05] mb-7 lg:mb-8
                 text-4xl sm:text-5xl lg:text-[3.8rem] xl:text-[4.2rem]">
        Siente que estás<br />lejos de todo.
      </h1>

      <p class="text-base text-[13px] font-semibold mb-1 leading-snug">
        Residencial Costamare · Brisas de Punta Cana · 12 apartamentos
      </p>
      <p class="text-base text-[13px] font-normal leading-snug mb-8 lg:mb-10">
        2 habitaciones · patios en primer nivel · terrazas amplias en tercer nivel
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <button class="px-6 py-3 bg-[#4A4829] text-white rounded-full text-sm font-medium cursor-pointer">
          Ver apartamentos
        </button>
        <button class="px-6 py-3 border border-[#4A4829] text-[#4A4829] rounded-full text-sm font-medium bg-transparent cursor-pointer">
          Conocer el proyecto
        </button>
      </div>
    </div>

    <!-- Right column: image — fixed height on mobile/tablet, full height on lg+ -->
    <div class="h-64 sm:h-80 lg:h-auto lg:w-1/2 overflow-hidden shrink-0">
      <img
        src="/assets/gallery/lateral.jpg"
        alt="Residencial Costamare"
        class="w-full h-full object-cover object-center"
      />
    </div>

  </div>

  <!-- Stats bar — 2-col grid on mobile/tablet, 5-col on lg+ -->
  <div class="grid grid-cols-2 lg:grid-cols-5 bg-gray-100 border-t border-gray-200 shrink-0 px-[5vw]">

    <!-- 12 apartamentos -->
    <div class="flex items-center gap-2 lg:gap-3 px-5 lg:px-7 py-4 lg:py-5
                border-b border-r border-gray-200 lg:border-b-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="#63613B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
      <div>
        <span class="font-black-mango font-bold text-second text-[1.9rem] lg:text-[2.2rem] leading-none block">12</span>
        <span class="text-[11px] text-base leading-none">apartamentos</span>
      </div>
    </div>

    <!-- 3 niveles -->
    <div class="flex items-center gap-2 lg:gap-3 px-5 lg:px-7 py-4 lg:py-5
                border-b border-gray-200 lg:border-b-0 lg:border-r">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="#63613B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <polygon points="12 2 2 7 12 12 22 7 12 2"/>
        <polyline points="2 17 12 22 22 17"/>
        <polyline points="2 12 12 17 22 12"/>
      </svg>
      <div>
        <span class="font-black-mango font-bold text-second text-[1.9rem] lg:text-[2.2rem] leading-none block">3</span>
        <span class="text-[11px] text-base leading-none">niveles</span>
      </div>
    </div>

    <!-- 12 parqueos -->
    <div class="flex items-center gap-2 lg:gap-3 px-5 lg:px-7 py-4 lg:py-5
                border-b border-r border-gray-200 lg:border-b-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="#63613B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <rect x="1" y="3" width="15" height="13" rx="2"/>
        <path d="M16 8h4l3 3v5h-7V8z"/>
        <circle cx="5.5" cy="18.5" r="2.5"/>
        <circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
      <div>
        <span class="font-black-mango font-bold text-second text-[1.9rem] lg:text-[2.2rem] leading-none block">12</span>
        <span class="text-[11px] text-base leading-none">parqueos</span>
      </div>
    </div>

    <!-- Inicio -->
    <div class="flex items-center gap-2 lg:gap-3 px-5 lg:px-7 py-4 lg:py-5
                border-b border-gray-200 lg:border-b-0 lg:border-r">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="#63613B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <div>
        <span class="text-[11px] text-base leading-none block">Inicio:</span>
        <span class="font-semibold text-[13px] text-second leading-snug block">diciembre 2026</span>
      </div>
    </div>

    <!-- Entrega -->
    <div class="col-span-2 lg:col-span-1 flex items-center gap-2 lg:gap-3 px-5 lg:px-7 py-4 lg:py-5
                border-gray-200">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
           stroke="#63613B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/>
      </svg>
      <div>
        <span class="text-[11px] text-base leading-none block">Entrega:</span>
        <span class="font-semibold text-[13px] text-second leading-snug block">diciembre 2027</span>
      </div>
    </div>

  </div>
</section>
