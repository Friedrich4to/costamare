---
interface URow {
  id: number;
  numero: string;
  m2: number;
  patio_m2: number | null;
  terraza_m2: number | null;
  m2_total: number;
  disponibilidad: string;
  tour_url: string | null;
  gallery: string;
  precio: number;
}

interface Props {
  units: URow[];
  hideHeader?: boolean;
}

const { units: rawUnits, hideHeader = false } = Astro.props;

const units = rawUnits.map(u => ({
  id:             u.numero,
  numero:         u.numero,
  disponibilidad: u.disponibilidad,
  m2:             u.m2,
  patio_m2:       u.patio_m2,
  terraza_m2:     u.terraza_m2,
  m2_total:       u.m2_total,
  tourUrl:        u.tour_url ?? '#',
  precio:         u.precio,
}));

const floors = [
  { label: 'Penthouse (3er Nivel)', units: units.filter(u => u.numero.startsWith('3')) },
  { label: '2do Nivel',             units: units.filter(u => u.numero.startsWith('2')) },
  { label: '1er Nivel',             units: units.filter(u => u.numero.startsWith('1')) },
];

const statusLabel: Record<string, string> = {
  available: 'Disponible',
  reserved:  'Reservado',
  sold:      'Vendido',
};

const statusColor: Record<string, string> = {
  available: '#397207',
  reserved:  '#B8900D',
  sold:      '#C23E3E',
};

function getFeature(numero: string): string {
  if (numero === '101') return 'c/ Patio amplio';
  if (numero.startsWith('1')) return 'c/ Patio';
  if (numero.startsWith('2')) return 'c/ Balcón';
  return 'c/ Terraza & Balcón';
}

// SVG shape fill colors — available units use base (#63613B)
const svgFill: Record<string, string> = {
  available: '#63613B',
  reserved:  '#B8900D',
  sold:      '#C23E3E',
};
const svgBaseOpacity: Record<string, string> = {
  available: '0',
  reserved:  '0.2',
  sold:      '0.2',
};

const cardBorderColor: Record<string, string> = {
  reserved: 'rgba(184,144,13,0.45)',
  sold:     'rgba(194,62,62,0.45)',
};

const unitStatusMap = Object.fromEntries(units.map(u => [u.id, u.disponibilidad]));
const allUnitIds = ['101','102','103','104','201','202','203','204','301','302','303','304'];

// CSS filter to colorize black SVG icons to base color (#63613B)
const iconFilter = 'brightness(0) saturate(100%) invert(36%) sepia(14%) saturate(831%) hue-rotate(22deg) brightness(95%) contrast(87%)';
---

<section id="disponibilidad" class:list={["px-[4vw]", hideHeader ? "pt-4 pb-16" : "py-16"]}>
  <div class="max-w-7xl mx-auto">

    {!hideHeader && (
      <div class="mb-8 flex items-center gap-4 flex-wrap">
        <h2 class="font-display font-bold text-3xl uppercase">Unidades Disponibles</h2>
        <button
          id="du-pdf-btn"
          class="flex items-center gap-2 px-5 py-2.5 text-sm rounded-md bg-gray-100 border border-base/20 hover:bg-base hover:text-white transition-colors duration-500 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Descargar lista PDF
        </button>
      </div>
    )}

    <!-- Floor plan map — full width, not sticky -->
    <div class="relative mb-10">
      <svg
        class="absolute inset-0 w-full h-full"
        viewBox="0 0 2107 645"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        {allUnitIds.filter(id => id.startsWith('1')).map((id, i) => {
          const xs = [35, 602, 1053, 1646];
          const ws = [426, 451, 451, 426];
          const status = unitStatusMap[id] ?? 'available';
          return (
            <rect
              data-unit={id}
              class="du-unit-shape"
              style={`opacity:${svgBaseOpacity[status]};cursor:pointer;transition:opacity 0.2s`}
              data-base-opacity={svgBaseOpacity[status]}
              x={xs[i]} y="488" width={ws[i]} height="157"
              fill={svgFill[status]}
            />
          );
        })}
        {allUnitIds.filter(id => id.startsWith('2')).map((id, i) => {
          const xs = [35, 602, 1053, 1646];
          const ws = [426, 451, 451, 426];
          const status = unitStatusMap[id] ?? 'available';
          return (
            <rect
              data-unit={id}
              class="du-unit-shape"
              style={`opacity:${svgBaseOpacity[status]};cursor:pointer;transition:opacity 0.2s`}
              data-base-opacity={svgBaseOpacity[status]}
              x={xs[i]} y="331" width={ws[i]} height="157"
              fill={svgFill[status]}
            />
          );
        })}
        {allUnitIds.filter(id => id.startsWith('3')).map((id, i) => {
          const xs = [35, 602, 1053, 1646];
          const ws = [426, 451, 451, 426];
          const status = unitStatusMap[id] ?? 'available';
          return (
            <rect
              data-unit={id}
              class="du-unit-shape"
              style={`opacity:${svgBaseOpacity[status]};cursor:pointer;transition:opacity 0.2s`}
              data-base-opacity={svgBaseOpacity[status]}
              x={xs[i]} y="29" width={ws[i]} height="302"
              fill={svgFill[status]}
            />
          );
        })}
      </svg>

      <img
        src="/assets/unidades/units-base-building.svg"
        alt="Plano del edificio"
        class="relative w-full block pointer-events-none"
      />
    </div>

    <!-- Unit cards grouped by floor -->
    <div class="flex flex-col gap-8">
      {floors.map(floor => (
        <div>
          <h3 class="font-display font-bold text-xs uppercase tracking-[0.2em] text-base mb-3">
            {floor.label}
          </h3>
          <!-- items-start: each card only grows to its own height, not the row's max -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-start">
            {floor.units.map(unit => (
              <div
                class:list={[
                  'du-unit-card rounded-xl overflow-hidden cursor-pointer select-none bg-gray-100',
                  ['reserved','sold'].includes(unit.disponibilidad) && 'border',
                ]}
                data-unit={unit.id}
                style={['reserved','sold'].includes(unit.disponibilidad)
                  ? `border-color: ${cardBorderColor[unit.disponibilidad]}`
                  : undefined}
              >

                <!-- Always-visible info block -->
                <div class="px-4 pt-4 pb-1">

                  <!-- Row 1: unit number + status -->
                  <div class="flex items-center gap-2 mb-2">
                    <span class="font-display font-bold text-2xl leading-none text-[#2A2818]">
                      {unit.numero}
                    </span>
                    <span class="flex items-center gap-1.5">
                      <span
                        class="w-1.75 h-1.75 shrink-0 rounded-[1px]"
                        style={`background:${statusColor[unit.disponibilidad]}`}
                      ></span>
                      <span
                        class="text-[18px] font-medium leading-none"
                        style={`color:${statusColor[unit.disponibilidad]}`}
                      >
                        {statusLabel[unit.disponibilidad]}
                      </span>
                    </span>
                  </div>

                  <!-- Row 2: m² | price -->
                  <div class="flex items-center gap-1.5 mb-1.5">
                    <span class="text-[18px] text-second">{unit.m2_total} m²</span>
                    {!['reserved','sold'].includes(unit.disponibilidad) && (
                      <Fragment>
                        <span class="text-[18px] text-base/25">|</span>
                        <span class="text-[18px] font-bold text-second">US${unit.precio.toLocaleString('en-US')}</span>
                      </Fragment>
                    )}
                  </div>

                  <!-- Row 3: feature text + chevron (same line) -->
                  <div class="flex items-center justify-between gap-2 pb-2">
                    <p class="text-sm text-base m-0 leading-none">{getFeature(unit.numero)}</p>
                    <svg
                      class="du-chevron shrink-0 transition-transform duration-200"
                      xmlns="http://www.w3.org/2000/svg"
                      width="13" height="13" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round"
                      style="color: rgba(99,97,59,0.35)"
                    >
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </div>

                </div>

                <!-- Expanded detail (hidden by default) -->
                <div class="du-unit-detail hidden">
                  <div class="px-4 pt-2 pb-3 flex flex-col gap-2">

                    <!-- Icons row -->
                    <div class="flex items-center gap-5">
                      <span class="flex items-center gap-1.5">
                        <img
                          src="/assets/icons/room.svg" alt="" aria-hidden="true"
                          class="h-4.5 w-auto"
                          style={`filter:${iconFilter}`}
                        />
                        <span class="text-sm font-semibold text-second">2</span>
                      </span>
                      <span class="flex items-center gap-1.5">
                        <img
                          src="/assets/icons/bath.svg" alt="" aria-hidden="true"
                          class="h-4.5 w-auto"
                          style={`filter:${iconFilter}`}
                        />
                        <span class="text-sm font-semibold text-second">2</span>
                      </span>
                      <span class="flex items-center gap-1.5">
                        <img
                          src="/assets/icons/parqueo.svg" alt="" aria-hidden="true"
                          class="h-4.5 w-auto"
                          style={`filter:${iconFilter}`}
                        />
                        <span class="text-sm font-semibold text-second">1</span>
                      </span>
                    </div>

                    <!-- Tour 360° button -->
                    <a
                      href="/tour/exterior"
                      class="hidden text-center px-4 py-2.5 rounded-lg bg-[#252515] text-white font-bold text-sm no-underline hover:opacity-80 transition-opacity duration-200"
                    >
                      Tour 360°
                    </a>

                    <!-- Ficha técnica button -->
                    <a
                      href={`/assets/units_info/${unit.id}.pdf`}
                      download
                      class="hidden text-center px-4 py-2.5 rounded-lg border border-base/25 text-base/65 text-sm font-medium no-underline hover:bg-base/5 transition-colors duration-200"
                    >
                      Ficha técnica
                    </a>

                  </div>
                </div>

              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function getShape(unitId: string) {
    return document.querySelector<SVGRectElement>(`.du-unit-shape[data-unit="${unitId}"]`);
  }

  function isOpen(card: HTMLElement) {
    return !card.querySelector<HTMLElement>('.du-unit-detail')!.classList.contains('hidden');
  }

  function openUnit(unitId: string) {
    document.querySelectorAll<HTMLElement>('.du-unit-card').forEach(card => {
      const detail  = card.querySelector<HTMLElement>('.du-unit-detail')!;
      const chevron = card.querySelector<SVGElement>('.du-chevron')!;
      const shape   = getShape(card.dataset.unit!);
      const baseOp  = shape?.dataset.baseOpacity ?? '0';

      if (card.dataset.unit === unitId) {
        const opening = detail.classList.contains('hidden');
        detail.classList.toggle('hidden', !opening);
        chevron.style.transform = opening ? 'rotate(180deg)' : '';
        if (shape) shape.style.opacity = opening ? '0.5' : baseOp;
        if (opening) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        detail.classList.add('hidden');
        chevron.style.transform = '';
        if (shape) shape.style.opacity = baseOp;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.du-unit-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      openUnit(card.dataset.unit!);
    });

    card.addEventListener('mouseenter', () => {
      if (isOpen(card)) return;
      const shape = getShape(card.dataset.unit!);
      if (shape) shape.style.opacity = '0.4';
    });
    card.addEventListener('mouseleave', () => {
      if (isOpen(card)) return;
      const shape = getShape(card.dataset.unit!);
      if (shape) shape.style.opacity = shape.dataset.baseOpacity ?? '0';
    });
  });

  document.querySelectorAll<SVGRectElement>('.du-unit-shape').forEach(shape => {
    shape.addEventListener('click', () => openUnit(shape.dataset.unit!));
    shape.addEventListener('mouseenter', () => {
      if (shape.style.opacity !== '0.5') shape.style.opacity = '0.4';
    });
    shape.addEventListener('mouseleave', () => {
      if (shape.style.opacity === '0.4') shape.style.opacity = shape.dataset.baseOpacity ?? '0';
    });
  });

  const pdfBtn = document.getElementById('du-pdf-btn') as HTMLButtonElement | null;
  pdfBtn?.addEventListener('click', async () => {
    const originalHTML = pdfBtn.innerHTML;
    pdfBtn.disabled = true;
    pdfBtn.textContent = 'Generando PDF…';

    try {
      const res = await fetch('/api/pdf', { method: 'POST' });
      if (!res.ok) throw new Error();

      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'listado-precios-costamare.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    } catch {
      alert('Error generando el PDF. Inténtalo de nuevo.');
    } finally {
      pdfBtn.disabled = false;
      pdfBtn.innerHTML = originalHTML;
    }
  });
</script>
