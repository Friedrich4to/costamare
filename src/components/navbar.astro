---
const links = [
  { label: 'Características', href: '#descripcion',    icon: false, disabled: false },
  { label: 'Disponibilidad',  href: '#disponibilidad', icon: false, disabled: false },
  { label: 'Tour 360°',       href: '/tour/exterior',  icon: true,  disabled: true  },
  { label: 'Ubicación',       href: '#map',            icon: false, disabled: false },
]
---

<nav
  id="main-nav"
  style="height: 10svh"
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 bg-white backdrop-blur-sm -translate-y-full transition-transform duration-500 ease-in-out"
>
  <a href="#" aria-label="Costamare inicio">
    <img src="/logo.svg" alt="Costamare" class="h-8 w-auto" />
  </a>

  <ul class="hidden lg:flex items-center gap-6">
    {links.map(({ label, href, icon, disabled }) => (
      <li>
        <a
          href={disabled ? undefined : href}
          aria-disabled={disabled ? 'true' : undefined}
          class:list={[
            "inline-flex items-center gap-1 text-[16px] font-medium transition-colors duration-200",
            disabled
              ? "text-gray-400 opacity-40 pointer-events-none cursor-default"
              : "text-gray-700 hover:text-black"
          ]}
        >
          {label}
          {icon && (
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>

  <a
    href="/dossier.pdf"
    download="dossier-costamare.pdf"
    class="hidden lg:flex items-center gap-1.5 px-4 py-2 text-[16px] rounded-full bg-base text-white hover:bg-base/80 transition-colors duration-200 no-underline font-medium"
  >
    Descargar Dossier
  </a>

  <button
    id="burger-btn"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
    class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    <span class="burger-line block w-6 h-0.5 bg-base rounded-full origin-center transition-transform duration-300"></span>
    <span class="burger-line block w-6 h-0.5 bg-base rounded-full origin-center transition-opacity  duration-300"></span>
    <span class="burger-line block w-6 h-0.5 bg-base rounded-full origin-center transition-transform duration-300"></span>
  </button>
</nav>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  style="top: 10svh; height: 90svh"
  class="fixed left-0 right-0 z-40 bg-white -translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
>
  <ul class="flex flex-col items-start justify-center h-full gap-8 px-8">
    {links.map(({ label, href, icon, disabled }) => (
      <li>
        <a
          href={disabled ? undefined : href}
          aria-disabled={disabled ? 'true' : undefined}
          class:list={[
            "mobile-nav-link inline-flex items-center gap-1.5 text-2xl font-medium transition-colors duration-200",
            disabled
              ? "text-gray-400 opacity-40 pointer-events-none cursor-default"
              : "text-gray-700 hover:text-black"
          ]}
        >
          {label}
          {icon && (
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          )}
        </a>
      </li>
    ))}
    <li>
      <a
        href="/dossier.pdf"
        download="dossier-costamare.pdf"
        class="mobile-nav-link text-2xl font-medium text-gray-700 hover:text-black transition-colors duration-200 no-underline"
      >
        Descargar Dossier
      </a>
    </li>
  </ul>
</div>

<style>
  #burger-btn[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #burger-btn[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
  }
  #burger-btn[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(#descripcion, #disponibilidad, #map) {
    scroll-margin-top: 6rem;
  }
</style>

<script>
  const nav       = document.getElementById('main-nav')       as HTMLElement
  const burgerBtn = document.getElementById('burger-btn')     as HTMLButtonElement
  const mobileMenu = document.getElementById('mobile-menu')   as HTMLDivElement
  const mobileLinks = mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link')

  // Show/hide nav on scroll past 50svh
  const threshold = window.innerHeight * 0.5

  function onScroll(): void {
    if (window.scrollY > threshold) {
      nav.classList.remove('-translate-y-full')
      nav.classList.add('translate-y-0')
    } else {
      nav.classList.add('-translate-y-full')
      nav.classList.remove('translate-y-0')
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true })

  // Mobile menu
  function openMenu(): void {
    mobileMenu.classList.remove('-translate-x-full')
    mobileMenu.classList.add('translate-x-0')
    burgerBtn.setAttribute('aria-expanded', 'true')
    burgerBtn.setAttribute('aria-label', 'Cerrar menú')
    document.body.classList.add('overflow-hidden')
  }

  function closeMenu(): void {
    mobileMenu.classList.remove('translate-x-0')
    mobileMenu.classList.add('-translate-x-full')
    burgerBtn.setAttribute('aria-expanded', 'false')
    burgerBtn.setAttribute('aria-label', 'Abrir menú')
    document.body.classList.remove('overflow-hidden')
  }

  burgerBtn.addEventListener('click', () => {
    burgerBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
  })

  mobileLinks.forEach(link => link.addEventListener('click', closeMenu))

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && burgerBtn.getAttribute('aria-expanded') === 'true') {
      closeMenu()
      burgerBtn.focus()
    }
  })
</script>
